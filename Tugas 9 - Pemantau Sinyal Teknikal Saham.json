    {
      "parameters": {
        "jsCode": "// Hitung SMA 50, SMA 200, RSI 14 lalu deteksi sinyal untuk setiap aset\nfunction sma(arr, p) {\n  if (arr.length < p) return null;\n  const s = arr.slice(-p);\n  return s.reduce((a, b) => a + b, 0) / p;\n}\n\n// RSI metode Wilder (smoothing)\nfunction rsi(closes, period = 14) {\n  if (closes.length <= period) return null;\n  let gain = 0, loss = 0;\n  for (let i = 1; i <= period; i++) {\n    const d = closes[i] - closes[i - 1];\n    if (d >= 0) gain += d; else loss -= d;\n  }\n  let avgG = gain / period;\n  let avgL = loss / period;\n  for (let i = period + 1; i < closes.length; i++) {\n    const d = closes[i] - closes[i - 1];\n    avgG = (avgG * (period - 1) + (d > 0 ? d : 0)) / period;\n    avgL = (avgL * (period - 1) + (d < 0 ? -d : 0)) / period;\n  }\n  if (avgL === 0) return 100;\n  return 100 - 100 / (1 + avgG / avgL);\n}\n\nconst r2 = (n) => (n === null ? null : Math.round(n * 100) / 100);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const result = item.json?.chart?.result?.[0];\n  if (!result) {\n    out.push({ json: { symbol: 'UNKNOWN', error: 'Data tidak ditemukan', hasSignal: false, signalText: 'Data tidak tersedia' } });\n    continue;\n  }\n\n  const symbol = result.meta.symbol;\n  const currency = result.meta.currency || '';\n  const closes = (result.indicators.quote[0].close || []).filter((c) => c !== null && c !== undefined);\n\n  const lastPrice = closes[closes.length - 1];\n  const sma50 = sma(closes, 50);\n  const sma200 = sma(closes, 200);\n  const rsi14 = rsi(closes, 14);\n\n  // Logika pendeteksi sinyal\n  const signals = [];\n  if (sma50 !== null && sma200 !== null && sma50 > sma200) signals.push('Golden Cross (MA50 > MA200) - Buy Signal');\n  if (rsi14 !== null && rsi14 < 30) signals.push('RSI Oversold (RSI < 30) - Potensi Buy');\n\n  out.push({\n    json: {\n      symbol,\n      currency,\n      dataPoints: closes.length,\n      lastPrice: r2(lastPrice),\n      sma50: r2(sma50),\n      sma200: r2(sma200),\n      rsi14: r2(rsi14),\n      signals,\n      signalText: signals.length ? signals.join(' + ') : 'Tidak ada sinyal (Market Netral)',\n      hasSignal: signals.length > 0,\n    },\n  });\n}\n\nreturn out;"
      },
