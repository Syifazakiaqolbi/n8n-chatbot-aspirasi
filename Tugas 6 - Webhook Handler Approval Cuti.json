    {
      "parameters": {
        "jsCode": "// Validasi parameter keputusan & status log\nconst q = $('Webhook Approval').first().json.query || {};\nconst log = $input.first().json || {};\nconst decision = String(q.status || '').toLowerCase();\n\nlet valid = false;\nlet pesan = '';\nif (!log['ID Request']) pesan = 'ID request tidak ditemukan.';\nelse if (!['approved', 'rejected'].includes(decision)) pesan = 'Parameter status tidak valid.';\nelse if (log['Status'] !== 'Pending') pesan = `Request ini sudah diproses sebelumnya (status: ${log['Status']}).`;\nelse valid = true;\n\nreturn [{ json: { ...log, decision, valid, pesan } }];"
      },
