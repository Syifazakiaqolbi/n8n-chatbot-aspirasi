    {
      "parameters": {
        "jsCode": "// Hitung statistik sentimen (24 jam terakhir; jika kosong pakai semua data)\nconst rows = $input.all().map(i => i.json).filter(r => r.sentiment);\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\nconst recent = rows.filter(r => {\n  const t = new Date(r.saved_at).getTime();\n  return !isNaN(t) && t >= cutoff;\n});\nconst data = recent.length ? recent : rows;\n\nlet positive = 0, negative = 0, neutral = 0;\nfor (const r of data) {\n  const s = String(r.sentiment).trim().toLowerCase();\n  if (s.startsWith('pos')) positive++;\n  else if (s.startsWith('neg')) negative++;\n  else neutral++;\n}\n\nconst total = positive + negative + neutral;\nconst pct = n => total ? Math.round((n / total) * 1000) / 10 : 0;\n\nconst counts = { Positive: positive, Negative: negative, Neutral: neutral };\nconst max = Math.max(positive, negative, neutral);\nconst leaders = Object.keys(counts).filter(k => counts[k] === max);\nconst dominant = !total\n  ? 'Tidak ada data'\n  : leaders.length > 1\n    ? 'Seimbang (' + leaders.join(' = ') + ')'\n    : leaders[0];\n\nreturn [{\n  json: {\n    periode: recent.length ? '24 jam terakhir' : 'seluruh data historis',\n    total,\n    positive, negative, neutral,\n    pct_positive: pct(positive),\n    pct_negative: pct(negative),\n    pct_neutral: pct(neutral),\n    dominant,\n    dominant_pct: total ? pct(max) : 0\n  }\n}];"
      },
      "id": "ca98d157-da42-4e41-9008-6337a2e622d0",
      "name": "Analisis Data",
