      "parameters": {
        "jsCode": "// DATA UJI: meniru output node X (Twitter) karena kredit API X habis\nconst samples = [\n  '$BTC just broke resistance, this rally looks super strong! Bullish all the way.',\n  '$ETH gas fees are insane again, this market is a disaster. Selling everything.',\n  'Watching $BTC and $ETH today. Volume is average, no clear direction yet.',\n  '$ETH staking yields keep growing, great news for long term holders!',\n  'Another exchange hack... $BTC dumping hard, so much fear in the market.',\n  '$BTC dominance steady at 52% today. Waiting for the Fed announcement.',\n  'Institutional inflows into $ETH ETFs are huge this week. Very optimistic.',\n  'I lost half my portfolio on $ETH. Terrible week, never investing again.',\n  '$BTC trading sideways between 60k and 62k. Nothing new.',\n  'Love seeing $BTC adoption growing in emerging markets. Amazing progress!'\n];\nconst now = Date.now();\n   return samples.slice(0, 3).map((text, i) => ({\n  json: {\n    id: String(now + i),\n    text,\n    created_at: new Date(now - i * 60000).toISOString()\n  }\n}));"
      },
