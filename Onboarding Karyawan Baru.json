      "parameters": {
        "jsCode": "// Ubah tiap baris sheet \"Checklist\" menjadi 1 item tugas + ID checklist Trello\nconst checklistId = $('Membuat Checklist').first().json.id;\n\nreturn $input.all()\n  .map(item => {\n    const j = item.json;\n    const tugas = j.Tugas || j.tugas || j.Task || j['Daftar Tugas'] || Object.values(j)[0] || '';\n    return { json: { checklistId, tugas: String(tugas).trim() } };\n  })\n  .filter(item => item.json.tugas !== '');"
      },
