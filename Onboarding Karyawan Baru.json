    {
      "parameters": {
        "jsCode": "// Gabungkan data diri karyawan + daftar tugas menjadi 1 objek JSON\nconst dataDiri = $('Normalisasi Data').first().json;\nconst tugas = $('Siapkan Item Checklist').all().map(i => i.json.tugas);\n\nconst daftarHtml = '<ul>' + tugas.map(t => `<li>${t}</li>`).join('') + '</ul>';\n\nreturn [{\n  json: {\n    nama: dataDiri.full_name,\n    first_name: dataDiri.first_name,\n    email: dataDiri.email,\n    posisi: dataDiri.position,\n    tugas,\n    daftar_tugas_html: daftarHtml\n  }\n}];"
      },
