        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #ddd;border-radius:8px;padding:24px\"><h2 style=\"margin-top:0\">Pengajuan Cuti Karyawan</h2><table style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:6px 0\"><b>ID Request</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.request_id }}</td></tr><tr><td style=\"padding:6px 0\"><b>Nama</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.nama }}</td></tr><tr><td style=\"padding:6px 0\"><b>Email</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.email }}</td></tr><tr><td style=\"padding:6px 0\"><b>Periode</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.tanggal_mulai }} s/d {{ $('Hitung Durasi & Validasi Saldo').first().json.tanggal_selesai }}</td></tr><tr><td style=\"padding:6px 0\"><b>Durasi</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.durasi }} hari</td></tr><tr><td style=\"padding:6px 0\"><b>Sisa Saldo</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.saldo_lama }} hari</td></tr><tr><td style=\"padding:6px 0\"><b>Alasan</b></td><td>{{ $('Hitung Durasi & Validasi Saldo').first().json.alasan }}</td></tr></table><p style=\"margin-top:24px\"><a href=\"{{ $('Hitung Durasi & Validasi Saldo').first().json.link_setuju }}\" style=\"background:#16a34a;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:bold;margin-right:8px\">SETUJUI</a><a href=\"{{ $('Hitung Durasi & Validasi Saldo').first().json.link_tolak }}\" style=\"background:#dc2626;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;font-weight:bold\">TOLAK</a></p></div>",
