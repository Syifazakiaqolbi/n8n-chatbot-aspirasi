    {
      "parameters": {
        "jsCode": "// Hitung durasi cuti (Luxon) & validasi saldo\nconst form = $('Form Pengajuan Cuti').first().json;\nconst emp = $input.first().json || {};\n\nconst mulai = DateTime.fromISO(form['Tanggal Mulai'], { zone: 'Asia/Jakarta' });\nconst selesai = DateTime.fromISO(form['Tanggal Selesai'], { zone: 'Asia/Jakarta' });\n\nconst ditemukan = !!emp['Email'];\nconst tanggalValid = mulai.isValid && selesai.isValid && selesai >= mulai;\nconst durasi = tanggalValid ? Math.floor(selesai.diff(mulai, 'days').days) + 1 : 0;\nconst saldo = Number(emp['Saldo Cuti'] || 0);\n\nlet catatan = 'OK';\nif (!ditemukan) catatan = 'Email tidak terdaftar di database karyawan.';\nelse if (!tanggalValid) catatan = 'Tanggal tidak valid (tanggal selesai harus >= tanggal mulai).';\nelse if (saldo < durasi) catatan = `Saldo cuti tidak mencukupi (saldo ${saldo} hari, diminta ${durasi} hari).`;\n\nconst saldoCukup = ditemukan && tanggalValid && saldo >= durasi;\nconst requestId = 'CUTI-' + DateTime.now().setZone('Asia/Jakarta').toFormat('yyyyLLddHHmmss');\nconst BASE_URL = 'https://n8n-hnzqgvnekter.eu1.sumopod.my.id/webhook/approval-cuti';\n\nreturn [{ json: {\n  request_id: requestId,\n  email: form['Email'],\n  nama: emp['Nama'] || form['Email'],\n  email_manajer: emp['Email Manajer'] || '',\n  tanggal_mulai: mulai.isValid ? mulai.toFormat('yyyy-LL-dd') : form['Tanggal Mulai'],\n  tanggal_selesai: selesai.isValid ? selesai.toFormat('yyyy-LL-dd') : form['Tanggal Selesai'],\n  alasan: form['Alasan'],\n  durasi,\n  saldo_lama: saldo,\n  saldo_cukup: saldoCukup,\n  catatan,\n  waktu_pengajuan: DateTime.now().setZone('Asia/Jakarta').toFormat('yyyy-LL-dd HH:mm:ss'),\n  link_setuju: `${BASE_URL}?id=${requestId}&status=approved`,\n  link_tolak: `${BASE_URL}?id=${requestId}&status=rejected`\n}}];"
      },
