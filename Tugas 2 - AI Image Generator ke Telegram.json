    {
      "parameters": {
        "jsCode": "// Parse resultJson dari Kie AI dan ambil URL gambar yang valid\nconst data = $input.first().json.data;\n\nlet result = data.resultJson;\nif (typeof result === 'string') {\n  result = JSON.parse(result);\n}\n\nconst urls = (result.resultUrls || []).filter(\n  (u) => typeof u === 'string' && /^https?:\\/\\//.test(u)\n);\n\nif (urls.length === 0) {\n  throw new Error('Tidak ada URL gambar valid pada resultUrls');\n}\n\nreturn [\n  {\n    json: {\n      taskId: data.taskId,\n      imageUrl: urls[0],\n      allUrls: urls,\n    },\n  },\n];"
      },
      "id": "b8c4200b-85b0-4278-ae8b-73ab8517823f",
