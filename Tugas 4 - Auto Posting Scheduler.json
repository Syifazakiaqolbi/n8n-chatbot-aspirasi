    {
      "parameters": {
        "jsCode": "// Validasi waktu jadwal dengan Luxon (zona waktu Asia/Jakarta)\n// Format tanggal di Sheet: 11/02/2026 -> sesuaikan urutan bila Sheet kamu dd/MM/yyyy\nconst DATE_FORMATS = ['M/d/yyyy', 'd/M/yyyy'];   // dicoba berurutan; ubah urutan jika perlu\nconst TIME_FORMATS = ['H:mm:ss', 'H:mm'];\nconst ZONE = 'Asia/Jakarta';\n\nconst now = DateTime.now().setZone(ZONE);\nconst results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const dateStr = String(row['Scheduled Date'] ?? '').trim();\n  const timeStr = String(row['Scheduled Time'] ?? '').trim();\n\n  let scheduled = null;\n  for (const df of DATE_FORMATS) {\n    for (const tf of TIME_FORMATS) {\n      const dt = DateTime.fromFormat(`${dateStr} ${timeStr}`, `${df} ${tf}`, { zone: ZONE });\n      if (dt.isValid) { scheduled = dt; break; }\n    }\n    if (scheduled) break;\n  }\n\n  // Lewati baris dengan format tidak valid\n  if (!scheduled) continue;\n\n  // Hanya lanjut jika jadwal sudah lewat / sama dengan waktu sekarang\n  if (scheduled <= now) {\n    results.push({\n      json: {\n        ...row,\n        scheduled_iso: scheduled.toISO(),\n        now_iso: now.toISO(),\n        is_due: true\n      }\n    });\n  }\n}\n\nreturn results;"
      },
