        }
      },
      "id": "e0d436ca-99e0-4ef4-a6a3-234b111c3744",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        720,
        560
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "XjzcZfa6WzCMZLkr",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const teks = String($json.text || '');\nconst email = $('Ekstrak Domain').item.json;\n\n// Cari angka skor: prioritas pola \"SKOR: n\", lalu \"n/10\", lalu angka 1-10 pertama\nconst cocok =\n  teks.match(/SKOR\\s*[:=]?\\s*(\\d{1,2})/i) ||\n  teks.match(/\\b(10|[1-9])\\s*\\/\\s*10\\b/) ||\n  teks.match(/\\b(10|[1-9])\\b/);\n\nlet skor = cocok ? parseInt(cocok[1], 10) : NaN;\nlet gagalParse = false;\n\n// Fail-safe: jika skor tidak terbaca / di luar 1-10, anggap mencurigakan agar tetap ditinjau manusia\nif (isNaN(skor) || skor < 1 || skor > 10) {\n  skor = 7;\n  gagalParse = true;\n}\n\nreturn {\n  json: {\n    id: email.id,\n    threadId: email.threadId,\n    pengirim: email.pengirim,\n    subjek: email.subjek,\n    domain: email.domain,\n    skor,\n    gagalParse,\n    responAI: teks\n  }\n};"
      },
