    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: Arial, Helvetica, sans-serif; color: #1f2937; margin: 0; padding: 40px; }\n  .header { display: flex; justify-content: space-between; border-bottom: 3px solid #2563eb; padding-bottom: 16px; }\n  .header h1 { margin: 0; color: #2563eb; font-size: 32px; }\n  .meta { text-align: right; font-size: 13px; line-height: 1.6; }\n  .client { margin: 28px 0; font-size: 14px; }\n  .client .label { color: #6b7280; font-size: 12px; text-transform: uppercase; }\n  .client .name { font-size: 18px; font-weight: bold; }\n  table { width: 100%; border-collapse: collapse; margin-top: 8px; }\n  th { background: #2563eb; color: #fff; text-align: left; padding: 10px; font-size: 13px; }\n  td { padding: 10px; border-bottom: 1px solid #e5e7eb; font-size: 14px; }\n  .right { text-align: right; }\n  .total { margin-top: 20px; text-align: right; font-size: 20px; font-weight: bold; }\n  .total span { color: #2563eb; }\n  .note { margin-top: 40px; padding: 12px; background: #f3f4f6; font-size: 12px; color: #4b5563; border-radius: 4px; }\n</style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>INVOICE</h1>\n    <div class=\"meta\">\n      <div><b>No. Invoice:</b> {{ $json.nomor_invoice }}</div>\n      <div><b>Tanggal:</b> {{ $json.tanggal_invoice }}</div>\n    </div>\n  </div>\n\n  <div class=\"client\">\n    <div class=\"label\">Ditagihkan kepada</div>\n    <div class=\"name\">{{ $json.nama_klien }}</div>\n    <div>{{ $json.email_klien }}</div>\n  </div>\n\n  <table>\n    <thead>\n      <tr>\n        <th>Deskripsi</th>\n        <th class=\"right\">Jam Kerja</th>\n        <th class=\"right\">Rate / Jam</th>\n        <th class=\"right\">Subtotal</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>Jasa profesional</td>\n        <td class=\"right\">{{ $json.jam_kerja }} jam</td>\n        <td class=\"right\">{{ $json.rate_idr }}</td>\n        <td class=\"right\">{{ $json.total_biaya_idr }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"total\">Total Biaya: <span>{{ $json.total_biaya_idr }}</span></div>\n\n  <div class=\"note\">Terima kasih atas kepercayaan Anda. Harap lakukan pembayaran sesuai detail yang telah disepakati.</div>\n</body>\n</html>"
      },
