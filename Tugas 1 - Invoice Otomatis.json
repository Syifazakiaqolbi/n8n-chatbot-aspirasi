              "value": "={{ new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number($json['Jam Kerja']) * Number($json['Rate per Jam'])) }}",
              "type": "string"
