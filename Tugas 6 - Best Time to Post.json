    {
      "parameters": {
        "jsCode": "// Hitung Engagement Score tiap postingan dengan bobot\nconst WEIGHT = { likes: 1, comments: 2, shares: 3 };\nconst num = v => Number(String(v ?? '').replace(/[^0-9.-]/g, '')) || 0;\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n\n  // Jam posting: \"9\" atau \"09:00\" -> 9\n  const jam = parseInt(String(r['Jam Posting']).split(':')[0], 10);\n  if (Number.isNaN(jam)) continue;   // lewati baris kosong/tidak valid\n\n  const likes = num(r['Likes']);\n  const comments = num(r['Comments']);\n  const shares = num(r['Shares']);\n\n  const engagement_score =\n    likes * WEIGHT.likes + comments * WEIGHT.comments + shares * WEIGHT.shares;\n\n  out.push({ json: {\n    tanggal: r['Tanggal Posting'], jam, platform: r['Platform'],\n    likes, comments, shares, engagement_score\n  } });\n}\nreturn out;"
      },
      "id": "1cbafa70-646f-4392-aa70-67e1a2fdde35",
      "name": "Hitung Engagement Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agregasi: rata-rata engagement per jam, urutkan, ambil 5 jam terbaik\nconst all = $input.all();\nconst groups = {};\nfor (const { json: p } of all) {\n  const g = groups[p.jam] ??= { jam: p.jam, total: 0, likes: 0, comments: 0, shares: 0, count: 0, platforms: new Set() };\n  g.total += p.engagement_score;\n  g.likes += p.likes;\n  g.comments += p.comments;\n  g.shares += p.shares;\n  g.count += 1;\n  if (p.platform) g.platforms.add(p.platform);\n}\n\nconst r2 = n => Math.round(n * 100) / 100;\nconst ranked = Object.values(groups)\n  .map(g => ({ ...g, avg: r2(g.total / g.count) }))\n  .sort((a, b) => b.avg - a.avg || a.jam - b.jam)   // rata-rata tertinggi dulu\n  .slice(0, 5);                                      // 5 jam terbaik\n\nconst stamp = DateTime.now().setZone('Asia/Jakarta').toFormat('dd/MM/yyyy, HH.mm');\n\n// Kolom mengikuti header tab \"Hasil Analisis\"\nreturn ranked.map((g, i) => ({ json: {\n  'Peringkat': i + 1,\n  'Jam Posting': String(g.jam).padStart(2, '0') + ':00',\n  'Rata-rata Engagement': g.avg,\n  'Jumlah Posting': g.count,\n  'avgLikes': r2(g.likes / g.count),\n  'avgComments': r2(g.comments / g.count),\n  'avgShares': r2(g.shares / g.count),\n  'Dianalisis Pada': [...g.platforms].join(', '),\n  'engagementScore': g.avg,\n  'rekomendasi': i < 3 ? '⭐ SANGAT DIREKOMENDASIKAN' : '✅ DIREKOMENDASIKAN',\n  'tanggalAnalisis': stamp,\n  'totalDataDianalisis': all.length\n} }));"
      },
