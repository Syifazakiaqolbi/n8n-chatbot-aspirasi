    {
      "parameters": {
        "jsCode": "// Susun pesan Telegram (HTML parse mode: <b> untuk teks tebal)\nconst rows = $('Agregasi per Jam').all().map(i => i.json);\nconst medals = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\n\nconst tanggal = DateTime.now().setZone('Asia/Jakarta').setLocale('id').toFormat('cccc, dd LLLL yyyy');\n\nconst lines = rows.map((r, i) =>\n  `${medals[i]} <b>${r['Jam Posting']}</b> | skor rata-rata <b>${r['Rata-rata Engagement']}</b> (${r['Jumlah Posting']} posting)`\n);\n\nconst best = rows[0];\nconst message = [\n  '📊 <b>LAPORAN HARIAN: 5 JAM TERBAIK UNTUK POSTING</b>',\n  `🗓️ ${tanggal}`,\n  '',\n  ...lines,\n  '',\n  best ? `🚀 <b>Rekomendasi:</b> jadwalkan konten utama pukul <b>${best['Jam Posting']}</b> untuk engagement tertinggi!` : '',\n  '',\n  '<i>Engagement Score = Likes x1 + Comments x2 + Shares x3</i>'\n].join('\\n');\n\nreturn [{ json: { message } }];"
      },
