        "messages": {
          "messageValues": [
            {
              "message": "Kamu content planner media sosial. Dari pesan pengguna (format: tanggal | tema), buat rencana konten satu hari penuh dalam Bahasa Indonesia, 5 slot waktu. Setiap slot berisi time_slot (contoh 08:00-09:00), title (judul ide konten, singkat dan visual), dan focus (tujuan/fokus konten). Balas hanya sesuai format JSON yang diminta."
            }
          ]
        }
      },
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        560,
        624
      ],
      "id": "143c1557-1ab1-47b0-914d-5f1dccb47daf",
      "retryOnFail": true
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {}
      },
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        528,
        832
      ],
      "id": "3f3ee693-fe74-4b09-a733-aa7856af8ed5",
      "credentials": {
        "googlePalmApi": {
          "id": "XjzcZfa6WzCMZLkr",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"date\": {\n      \"type\": \"string\"\n    },\n    \"theme\": {\n      \"type\": \"string\"\n    },\n    \"plan\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"time_slot\": {\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"focus\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"time_slot\",\n          \"title\",\n          \"focus\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"plan\"\n  ]\n}"
      },
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        720,
        832
      ],
      "id": "caf588fc-e7ae-4265-b428-f763c6fad605"
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output;\nconst plan = out.plan || [];\nlet teks = `Rencana konten ${out.date || ''} - ${out.theme || ''}\\n\\n`;\nplan.forEach((p, i) => {\n  teks += `${i + 1}. ${p.time_slot}\\n   Judul: ${p.title}\\n   Fokus: ${p.focus}\\n\\n`;\n});\nteks += 'Balas dengan salah satu judul (teks biasa) untuk dibuatkan gambar.';\nreturn [{ json: { teks, plan } }];"
      },
